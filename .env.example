# Copy this file to `.env` and adjust values (the app loads `.env` from the working directory).
#   cp .env.example .env
#
# All variables are optional to list; unset entries use code defaults in `utils/config.py`.

# --- Service ---
APP_NAME=custom-ai-platform
LOG_LEVEL=INFO
# Logging sinks (JSON lines): console on stdout, optional append-only file under STORAGE_ROOT if relative.
LOG_CONSOLE_ENABLED=true
# LOG_FILE_PATH=storage/logs/app.log
# LOG_STARTUP_SUMMARY=true
HOST=0.0.0.0
PORT=8000
UVICORN_RELOAD=false

# --- Storage (paths relative to STORAGE_ROOT unless absolute) ---
STORAGE_ROOT=.
CHROMA_PATH=storage/chroma_data
CHECKPOINT_DIR=storage/checkpoints
VOCAB_PATH=storage/vocab/vocab.json
CHROMA_COLLECTION_NAME=knowledge

# --- Model identity & device ---
MODEL_NAME=custom-transformer-v1
DEVICE=auto

# --- Transformer shape ---
D_MODEL=256
N_HEADS=8
N_LAYERS=4
D_FF=1024
MAX_SEQ_LEN=512
VOCAB_SIZE=512
DROPOUT=0.1

# --- Training ---
LEARNING_RATE=0.0003
WEIGHT_DECAY=0.01
GRAD_CLIP=1.0
WARMUP_STEPS=100
MAX_TRAIN_STEPS=1000000
CHECKPOINT_EVERY_STEPS=10
EPOCH_SIZE_STEPS=100

# --- Inference / RAG ---
RETRIEVAL_TOP_K=4
GENERATION_TEMPERATURE=0.9
GENERATION_TOP_K=50

# --- Language defaults ---
# BCP47-style tag (e.g. en, hi, hi-in) stored on Chroma when POST /train omits `language`.
# Set empty (DEFAULT_LANGUAGE=) to skip auto-tagging legacy-style vectors.
DEFAULT_LANGUAGE=en

# --- HTTP ---
CORS_ENABLED=false
CORS_ALLOW_ORIGINS=*
